#!/usr/bin/env bash

set -uo pipefail

# ---------------------------------------------------------------------------
# Globals
# ---------------------------------------------------------------------------
declare -i SILENT=0
declare -i NOTIF_TIMEOUT=5000
declare -i DRYRUN=0
declare -i DEBUG=0
declare -i NO_XWAYLAND_MOUSE_RELEASE=0

declare MODE=""      # active | pid | name | custom
declare TARGET=""    # argument of the selected mode
declare DESKTOP=""
declare PID=""
declare PROC_NAME=""
declare ACTION=""    # Suspended | Resumed

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
function die() {
  echo "Error: $1" >&2
  exit 1
}

function debugPrint() {
  if (( DEBUG )); then
    echo "[DEBUG] $1" >&2
  fi
}

function has() {
  command -v "$1" >/dev/null 2>&1
}

function printHelp() {
  cat <<'EOF'
Usage: wl-freeze (-a | -p <pid> | -n <name> | -c <command>) [options]

Utility to suspend a game process (and other programs) in Wayland compositors.

Supported compositors: Hyprland, KWin (KDE Plasma), Niri, Sway

Options:
  -h, --help            show help message

  -a, --active          toggle suspend by active window
  -p, --pid             toggle suspend by process id
  -n, --name            toggle suspend by process name/command
  -c, --custom          toggle suspend by custom command (outputs a PID)

  -s, --silent          don't send notification
  -t, --notif-timeout   notification timeout in milliseconds (default 5000)
  --dry-run             don't actually suspend/resume a process
  --debug               enable debug mode
  --no-xwayland-mouse-release  skip the XWayland mouse capture release
EOF
}

# ---------------------------------------------------------------------------
# Compositor detection
# ---------------------------------------------------------------------------
function detectCompositor() {
  if has loginctl; then
    local session_id
    session_id=$(loginctl 2>/dev/null | awk -v u="$(whoami)" 'NR > 1 && $3 == u {print $1; exit}')
    if [[ -n "$session_id" ]]; then
      DESKTOP=$(loginctl show-session "$session_id" -p Desktop --value 2>/dev/null)
    fi
  fi

  if [[ -z "$DESKTOP" ]]; then
    DESKTOP="${XDG_SESSION_DESKTOP:-${XDG_CURRENT_DESKTOP:-}}"
  fi

  # Normalize
  DESKTOP="${DESKTOP,,}"
  DESKTOP="${DESKTOP%-uwsm}"

  debugPrint "Compositor: ${DESKTOP:-<unknown>}"
}

# ---------------------------------------------------------------------------
# getPid functions
# ---------------------------------------------------------------------------
# _NET_WM_PID is relative to the client's PID namespace, so for sandboxed
# clients (Proton's pressure-vessel, Flatpak) it isn't the host PID and may
# point at an unrelated process. Map it back through NSpid in /proc.
function resolveNamespacedPid() {
  local wm_pid=$1
  local -a candidates=()
  local file

  # The host process with that PID, unless it's a kernel thread (empty cmdline)
  if [[ -n $(tr -d '\0' 2>/dev/null <"/proc/$wm_pid/cmdline") ]]; then
    candidates+=("$wm_pid")
  fi

  # Sandboxed processes whose innermost PID matches
  while IFS= read -r file; do
    file=${file#/proc/}
    candidates+=("${file%/status}")
  done < <(grep -lE "^NSpid:([[:space:]]+[0-9]+)+[[:space:]]+$wm_pid\$" /proc/[0-9]*/status 2>/dev/null)

  debugPrint "Candidates for _NET_WM_PID $wm_pid: ${candidates[*]:-none}"

  case ${#candidates[@]} in
    1) PID=${candidates[0]} ;;
    0) die "No process found for _NET_WM_PID $wm_pid" ;;
    *) die "_NET_WM_PID $wm_pid is ambiguous (host PIDs: ${candidates[*]}), use -p instead" ;;
  esac
}

function getPidByActive() {
  debugPrint "Getting PID by active window..."

  case "$DESKTOP" in
    hyprland)
      PID=$(hyprctl activewindow -j | jq '.pid')
      ;;
    kde|plasma)
      PID=$(kdotool getactivewindow getwindowpid)
      ;;
    niri)
      local niri_pid proc_name
      niri_pid=$(niri msg --json focused-window | jq '.pid')
      proc_name=$(ps -p "$niri_pid" -o comm= 2>/dev/null)

      if [[ "$proc_name" == *xwayland* ]]; then
        # xwayland-satellite owns every X window, so ask X for the real client
        local wm_pid
        wm_pid=$(xdotool getactivewindow getwindowpid 2>/dev/null)
        if ! [[ "$wm_pid" =~ ^[1-9][0-9]*$ ]]; then
          die "xdotool returned an invalid PID. Is xdotool installed and an XWayland window focused?"
        fi
        debugPrint "xwayland-satellite window ($proc_name), _NET_WM_PID: $wm_pid"
        resolveNamespacedPid "$wm_pid"
      else
        PID=$niri_pid
      fi
      ;;
    sway)
      PID=$(swaymsg -t get_tree | jq '.. | select(.type?) | select(.focused == true) | .pid')
      ;;
    *)
      local reason="Could not detect the compositor."
      if [[ -n "$DESKTOP" ]]; then
        reason="Detecting the active window is currently not supported on: $DESKTOP"
      fi

      cat >&2 <<EOF
$reason

You can use a custom command to get the PID:
  wl-freeze -c "<command that outputs the PID>"

Example:
  wl-freeze -c "niri msg --json focused-window | jq '.pid'"

Please consider opening an issue on GitHub so native support can be added.
EOF
      exit 1
      ;;
  esac
}

function getPidByName() {
  debugPrint "Getting PID by name: $1"
  PID=$(pidof -x "$1" | awk '{print $NF}')
  if [[ -z "$PID" ]]; then
    die "Process name '$1' not found"
  fi
}

function getPidByCustom() {
  debugPrint "Getting PID by custom command: $1"

  local output
  if ! output=$(bash -c "$1" 2>/dev/null); then
    die "Custom command failed to execute: $1"
  fi

  PID=${output//[[:space:]]/}
  debugPrint "Custom command output: '$output'"
}

# ---------------------------------------------------------------------------
# Core logic
# ---------------------------------------------------------------------------
function getDescendants() {
  local -A child_map # parent_pid -> "child1 child2 ..."
  local root=$1
  local pid ppid

  # Accumulate all children inside child_map by reading a single system snapshot
  while read -r pid ppid; do
    child_map["$ppid"]+=" $pid"
  done < <(ps -eo pid,ppid --no-headers 2>/dev/null)

  # Scan the tree by reading PIDs from the queue and appending each PID's children from child_map to the queue
  local -a queue=("$root")
  local -i idx=0
  local child

  while (( idx < ${#queue[@]} )); do
    for child in ${child_map["${queue[idx]}"]:-}; do
      queue+=("$child")
    done
    (( idx++ ))
  done

  # Output every PID in the tree except the root
  if (( ${#queue[@]} > 1 )); then
    printf '%s\n' "${queue[@]:1}"
  fi
}

# A frozen X client keeps any pointer grab it holds, so the mouse stops working
# in every other XWayland window. Wine/Proton grab through an InputOnly,
# override-redirect "clip window": the X server drops a grab when its window is
# unmapped, and Wine maps it again by itself once resumed and focused.
# ponytail: unmaps every such window, not just the frozen game's (harmless for
# Wine, which remaps on its next ClipCursor). Native X11 games grabbing their
# own toplevel aren't covered.
function releaseMouseCapture() {
  if (( NO_XWAYLAND_MOUSE_RELEASE )); then
    debugPrint "XWayland mouse capture release disabled, skipping"
    return 0
  fi

  if [[ -z "${DISPLAY:-}" ]] || ! has xwininfo || ! has xdotool; then
    debugPrint "No X display or xwininfo/xdotool missing, skipping XWayland mouse capture release"
    return 0
  fi

  local win
  for win in $(xwininfo -root -children 2>/dev/null | awk '/^ +0x/ {print $1}'); do
    if xwininfo -id "$win" 2>/dev/null | awk '
        /Class: InputOnly/              {class = 1}
        /Map State: IsViewable/         {mapped = 1}
        /Override Redirect State: yes/  {override = 1}
        END {exit !(class && mapped && override)}'; then
      debugPrint "Unmapping clip window $win"
      xdotool windowunmap "$win"
    fi
  done
}

function toggleFreeze() {
  local state signal
  read -r state < <(ps -p "$PID" -o state= 2>/dev/null)
  PROC_NAME=$(ps -p "$PID" -o comm= 2>/dev/null) || PROC_NAME="Unknown"

  if [[ "${state:-}" == T ]]; then
    ACTION="Resumed"
    signal=CONT
  else
    ACTION="Suspended"
    signal=STOP
  fi

  if (( DRYRUN )); then
    debugPrint "Dry-run: not sending SIG$signal"
    return 0
  fi

  local -a pids
  mapfile -t pids < <(echo "$PID"; getDescendants "$PID")
  debugPrint "Process tree PIDs: ${pids[*]}"

  if [[ " ${pids[*]} " == *" $$ "* ]]; then
    die "Refusing to suspend the wl-freeze process itself"
  fi

  # Children may exit between the snapshot and the kill, so only the root counts
  debugPrint "Sending SIG$signal..."
  kill -"$signal" "${pids[@]}" 2>/dev/null
  if ! kill -0 "$PID" 2>/dev/null; then
    die "Failed to send SIG$signal to $PROC_NAME (PID $PID)"
  fi

  if [[ "$signal" == STOP ]]; then
    releaseMouseCapture
  fi

  echo "$ACTION $PROC_NAME (PID $PID)"
}

function sendNotification() {
  debugPrint "Sending notification..."
  notify-send "$ACTION $PROC_NAME" "PID $PID" -t "$NOTIF_TIMEOUT" -a wl-freeze
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
function setMode() {
  if [[ -n "$MODE" ]]; then
    die "Only one of -a, -p, -n, -c can be used"
  fi
  MODE=$1
  TARGET=${2:-}
}

function args() {
  local parsed
  parsed=$(getopt -o hap:n:c:st: \
    --long help,active,pid:,name:,custom:,silent,notif-timeout:,dry-run,debug,no-xwayland-mouse-release \
    -n "$(basename "$0")" -- "$@") || exit 1

  eval set -- "$parsed"
  while true; do
    case $1 in
      -h|--help)          printHelp; exit 0 ;;
      -a|--active)        setMode active ;;
      -p|--pid)           shift; setMode pid "$1" ;;
      -n|--name)          shift; setMode name "$1" ;;
      -c|--custom)        shift; setMode custom "$1" ;;
      -s|--silent)        SILENT=1 ;;
      -t|--notif-timeout) shift
                          [[ "$1" =~ ^[0-9]+$ ]] || die "Invalid notification timeout: $1"
                          NOTIF_TIMEOUT=$1 ;;
      --dry-run)          DRYRUN=1 ;;
      --debug)            DEBUG=1 ;;
      --no-xwayland-mouse-release) NO_XWAYLAND_MOUSE_RELEASE=1 ;;
      --)                 shift; break ;;
      *)                  exit 1 ;;
    esac
    shift
  done

  if [[ -z "$MODE" ]]; then
    printHelp
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
function main() {
  args "$@"
  debugPrint "Starting wl-freeze..."

  case "$MODE" in
    active) detectCompositor; getPidByActive ;;
    pid)    PID=$TARGET ;;
    name)   getPidByName "$TARGET" ;;
    custom) getPidByCustom "$TARGET" ;;
  esac

  if ! [[ "$PID" =~ ^[0-9]+$ && -d "/proc/$PID" ]]; then
    die "Not a running process: '$PID'"
  fi
  debugPrint "PID: $PID"

  toggleFreeze

  if (( !SILENT )); then
    sendNotification
  fi

  debugPrint "Done."
}

main "$@"
