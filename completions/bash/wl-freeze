_wl_freeze()
{
    local cur prev words cword
    _init_completion || return

    case $prev in
        -p|--pid)
            # Complete with running PIDs
            COMPREPLY=($(compgen -W "$(ps -e --no-headers -o pid | tr '\n' ' ')" -- "$cur"))
            return
            ;;
        -n|--name)
            # Complete with process names and argv[0] basenames, which is what -n matches
            COMPREPLY=($(compgen -W "$(awk 'BEGIN { RS = "\0" } FNR == 1 { n = split($0, p, "/"); n = split(p[n], p, sprintf("%c", 92)); print p[n]; f = FILENAME; sub(/cmdline$/, "comm", f); if ((getline c < f) > 0) { sub(/\n$/, "", c); print c }; close(f) }' /proc/[0-9]*/cmdline 2>/dev/null | sort -u)" -- "$cur"))
            return
            ;;
        -c|--custom)
            # No completion for custom command - user provides their own
            return
            ;;
        -t|--notif-timeout)
            # Complete with common timeout values
            COMPREPLY=($(compgen -W "1000 2000 3000 5000 10000" -- "$cur"))
            return
            ;;
    esac

    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "-h --help -a --active -p --pid -n --name -c --custom \
            -s --silent -t --notif-timeout --dry-run --debug --no-xwayland-mouse-release" -- "$cur"))
    else
        # When no option is specified, suggest main operation flags
        COMPREPLY=($(compgen -W "-a -p -n -c" -- "$cur"))
    fi
}

complete -F _wl_freeze wl-freeze