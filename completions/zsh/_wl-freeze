#compdef wl-freeze

# Process names and argv[0] basenames, which is what -n matches
_wl-freeze_names() {
    local -a names
    names=(${(f)"$(awk 'BEGIN { RS = "\0" } FNR == 1 { n = split($0, p, "/"); n = split(p[n], p, sprintf("%c", 92)); print p[n]; f = FILENAME; sub(/cmdline$/, "comm", f); if ((getline c < f) > 0) { sub(/\n$/, "", c); print c }; close(f) }' /proc/[0-9]*/cmdline 2>/dev/null | sort -u)"})
    compadd -a names
}

_wl-freeze() {
    _arguments \
        '(- *)'{-h,--help}'[show help message]' \
        {-a,--active}'[toggle suspend by active window]' \
        {-p,--pid}'[toggle suspend by process id]:pid:_pids' \
        {-n,--name}'[toggle suspend by process name/command]:process name:_wl-freeze_names' \
        {-c,--custom}'[toggle suspend by custom command (outputs a PID)]:custom command: ' \
        {-s,--silent}"[don't send notification]" \
        {-t,--notif-timeout}'[notification timeout in milliseconds (default 5000)]:timeout:(1000 2000 3000 5000 10000)' \
        "--dry-run[don't actually suspend/resume a process]" \
        '--debug[enable debug mode]' \
        '--no-xwayland-mouse-release[skip the XWayland mouse capture release]'
}

_wl-freeze "$@"
